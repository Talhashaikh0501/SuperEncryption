@{
    ViewData["Title"] = "SuperEncryption";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>SuperEncryption</title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            background: radial-gradient( circle at 15% 10%, rgba(111, 174, 255, .11), transparent 26% ), radial-gradient( circle at 85% 80%, rgba(124, 185, 255, .08), transparent 30% ), linear-gradient( 145deg, #ffffff, #f7fbff 50%, #f2f8ff );
            color: #172b43;
            font-family: Arial, Helvetica, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button,
        a {
            font: inherit;
        }


        /* =====================================================
                   PAGE
                   ===================================================== */

        .home-page {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }


        /* =====================================================
                   NAVBAR
                   ===================================================== */

        .navbar {
            width: 100%;
            min-height: 82px;
            padding: 0 6vw;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(202, 218, 235, .62);
            background: rgba(255, 255, 255, .78);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            position: relative;
            z-index: 20;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
            text-decoration: none;
        }

        .brand-logo {
            width: 42px;
            height: 42px;
            object-fit: contain;
            display: block;
        }

        .brand-name {
            color: #143b67;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: -.45px;
        }

        .nav-security {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #69839e;
            font-size: 11px;
            font-weight: 600;
        }

        .nav-security-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #20ad71;
            box-shadow: 0 0 0 4px rgba(32, 173, 113, .10);
        }


        /* =====================================================
                   HERO
                   ===================================================== */

        .hero {
            flex: 1;
            width: min(1180px, calc(100% - 50px));
            margin: auto;
            padding: 70px 0 55px;
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr);
            align-items: center;
            gap: 85px;
            position: relative;
            z-index: 5;
        }


        /* =====================================================
                   COPY
                   ===================================================== */

        .hero-copy {
            max-width: 600px;
        }

        .eyebrow {
            width: fit-content;
            margin-bottom: 22px;
            padding: 8px 12px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid #d7e6f6;
            border-radius: 999px;
            background: rgba(255, 255, 255, .72);
            color: #54769b;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

            .eyebrow svg {
                width: 14px;
                height: 14px;
                fill: none;
                stroke: #347bc7;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .hero h1 {
            margin: 0;
            color: #102d4e;
            font-size: clamp( 45px, 5vw, 74px );
            line-height: 1.03;
            font-weight: 700;
            letter-spacing: -.055em;
        }

            .hero h1 span {
                display: block;
                margin-top: 5px;
                color: #4f7bab;
                font-weight: 500;
            }

        .hero-description {
            max-width: 510px;
            margin: 26px 0 0;
            color: #6d849b;
            font-size: 16px;
            line-height: 1.75;
        }


        /* =====================================================
                   TRUST ROW
                   ===================================================== */

        .trust-row {
            margin-top: 35px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .trust-item {
            min-height: 38px;
            padding: 0 12px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: 1px solid #dce8f4;
            border-radius: 12px;
            background: rgba(255, 255, 255, .72);
            color: #69839d;
            font-size: 10px;
            font-weight: 600;
        }

            .trust-item svg {
                width: 15px;
                height: 15px;
                fill: none;
                stroke: #3d82cc;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }


        /* =====================================================
                   LOGIN CARD
                   ===================================================== */

        .access-card {
            width: 100%;
            padding: 46px 42px;
            border: 1px solid rgba(196, 217, 238, .92);
            border-radius: 30px;
            background: rgba(255, 255, 255, .76);
            box-shadow: 0 28px 80px rgba(46, 94, 145, .11);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            text-align: center;
            animation: cardEnter .65s cubic-bezier(.2, .75, .2, 1) both;
        }

        @@keyframes cardEnter {

            from {
                opacity: 0;
                transform: translateY(14px) scale(.985);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }


        /* =====================================================
                   LOGO
                   ===================================================== */

        .access-logo-shell {
            width: 84px;
            height: 84px;
            margin: 0 auto 25px;
            display: grid;
            place-items: center;
            border: 1px solid #d4e3f1;
            border-radius: 24px;
            background: linear-gradient( 145deg, #ffffff, #eff6fd );
            box-shadow: 0 15px 35px rgba(40, 91, 142, .10);
        }

        .access-logo {
            width: 52px;
            height: 52px;
            object-fit: contain;
        }

        .access-card h2 {
            margin: 0;
            color: #173957;
            font-size: 23px;
            font-weight: 700;
            letter-spacing: -.5px;
        }

        .access-card p {
            max-width: 380px;
            margin: 12px auto 0;
            color: #7a8fa3;
            font-size: 13px;
            line-height: 1.65;
        }


        /* =====================================================
                   LOGIN BUTTON
                   ===================================================== */

        .login-button {
            width: 100%;
            height: 56px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            border: 0;
            border-radius: 28px;
            background: #f1f3f5;
            color: #111111;
            text-decoration: none;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background .18s ease, transform .16s ease, box-shadow .18s ease;
        }

            .login-button:hover {
                background: #e8ebee;
                box-shadow: 0 8px 25px rgba(42, 86, 132, .08);
                transform: translateY(-1px);
            }

            .login-button:active {
                transform: scale(.985);
            }

        .button-logo {
            width: 21px;
            height: 21px;
            object-fit: contain;
        }


        /* =====================================================
                   SESSION TEXT
                   ===================================================== */

        .access-note {
            margin-top: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: #91a2b3;
            font-size: 9px;
        }

            .access-note svg {
                width: 12px;
                height: 12px;
                fill: none;
                stroke: #5f88b5;
                stroke-width: 1.7;
                stroke-linecap: round;
                stroke-linejoin: round;
            }


        /* =====================================================
                   FLOATING DECORATION
                   ===================================================== */

        .orb {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(2px);
        }

        .orb-one {
            width: 220px;
            height: 220px;
            top: 120px;
            right: -80px;
            border: 1px solid rgba(70, 136, 206, .08);
            background: rgba(83, 153, 225, .035);
        }

        .orb-two {
            width: 310px;
            height: 310px;
            left: -150px;
            bottom: -130px;
            border: 1px solid rgba(89, 152, 216, .07);
            background: rgba(91, 163, 235, .025);
        }


        /* =====================================================
                   FOOTER
                   ===================================================== */

        .footer {
            min-height: 70px;
            padding: 18px 6vw;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border-top: 1px solid rgba(211, 224, 237, .72);
            color: #8a9cac;
            font-size: 10px;
            position: relative;
            z-index: 5;
        }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
        }

            .footer-links span {
                cursor: default;
            }


        /* =====================================================
                   MOBILE
                   ===================================================== */

        @@media (max-width: 820px) {

            .navbar {
                min-height: 72px;
                padding: 0 20px;
            }

            .brand-logo {
                width: 35px;
                height: 35px;
            }

            .brand-name {
                font-size: 16px;
            }

            .nav-security {
                font-size: 9px;
            }

            .hero {
                width: min(100% - 32px, 560px);
                padding: 42px 0 38px;
                display: flex;
                flex-direction: column;
                gap: 40px;
            }

            .hero-copy {
                text-align: center;
            }

            .eyebrow {
                margin-left: auto;
                margin-right: auto;
            }

            .hero h1 {
                font-size: clamp( 38px, 11vw, 55px );
            }

            .hero-description {
                margin-left: auto;
                margin-right: auto;
                font-size: 14px;
            }

            .trust-row {
                justify-content: center;
            }

            .access-card {
                padding: 38px 26px;
                border-radius: 25px;
            }

            .footer {
                flex-direction: column;
                text-align: center;
            }

            .footer-links {
                justify-content: center;
            }
        }


        /* =====================================================
                   SMALL MOBILE
                   ===================================================== */

        @@media (max-width: 430px) {

            .navbar {
                padding: 0 15px;
            }

            .nav-security {
                display: none;
            }

            .hero {
                width: calc(100% - 24px);
                padding-top: 34px;
            }

                .hero h1 {
                    font-size: 39px;
                }

            .hero-description {
                max-width: 340px;
                font-size: 13px;
            }

            .trust-item {
                font-size: 9px;
            }

            .access-card {
                padding: 33px 20px;
            }

                .access-card h2 {
                    font-size: 20px;
                }

                .access-card p {
                    font-size: 12px;
                }
        }

    </style>

</head>


<body>


    <div class="home-page">


        <div class="orb orb-one">
        </div>

        <div class="orb orb-two">
        </div>



        <!-- =====================================================
             NAVBAR
             ===================================================== -->

        <header class="navbar">


            <a href="/"
               class="brand">


                <!--
                    TEMPORARY LOGO

                    Put your current Instagram logo file here:

                    wwwroot/images/instagram-logo.png

                    Your designer can later replace ONLY that image
                    with the final SuperEncryption logo.
                -->

                <img src="~/images/instagram-logo.png"
                     alt=""
                     class="brand-logo" />


                <span class="brand-name">
                    Instagram
                </span>

            </a>


            <div class="nav-security">

                <span class="nav-security-dot">
                </span>

                Secure communication platform

            </div>


        </header>



        <!-- =====================================================
             HERO
             ===================================================== -->

        <main class="hero">


            <!-- =================================================
                 TEXT
                 ================================================= -->

            <section class="hero-copy">


                <div class="eyebrow">

                    <svg viewBox="0 0 24 24">

                        <path d="M12 3 4.5 6.3v5.1c0 4.7 3 7.8 7.5 9.6 4.5-1.8 7.5-4.9 7.5-9.6V6.3L12 3Z" />

                        <path d="m9 12 2 2 4-4" />

                    </svg>

                    Private communication

                </div>


                <h1>

                    Stay connected.

                    <span>
                        Feel protected.
                    </span>

                </h1>


                <p class="hero-description">

                    SuperEncryption gives you a simple and
                    comfortable space to stay connected with the
                    people you trust, with private conversations,
                    live presence and a clean messaging experience.

                </p>



                <div class="trust-row">


                    <div class="trust-item">

                        <svg viewBox="0 0 24 24">

                            <path d="M5 12 9 16 19 6" />

                        </svg>

                        Private conversations

                    </div>


                    <div class="trust-item">

                        <svg viewBox="0 0 24 24">

                            <circle cx="12"
                                    cy="12"
                                    r="8">
                            </circle>

                            <path d="M12 8v4l3 2" />

                        </svg>

                        Real-time messaging

                    </div>


                    <div class="trust-item">

                        <svg viewBox="0 0 24 24">

                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />

                        </svg>

                        Controlled access


                        Log in with Instagram
                    </div>


                </div>


            </section>



            <!-- =================================================
                 LOGIN CARD
                 ================================================= -->

            <section class="access-card">


                <div class="access-logo-shell">

                    <img src="~/images/instagram-logo.png"
                         alt=""
                         class="access-logo" />

                </div>


                <h2>
                    Welcome to SuperEncryption
                </h2>


                <p>

                    Continue to your private messaging space
                    and connect securely with your contacts.

                </p>



                <!-- ONLY MAIN ACTION -->

                <a asp-controller="Auth"
                   asp-action="Login"
                   class="login-button">


                    <img src="~/images/instagram-logo.png"
                         alt=""
                         class="button-logo" />


                    <span>
                        Log in with Instagram
                    </span>

                </a>



                <div class="access-note">

                    <svg viewBox="0 0 24 24">

                        <rect x="5"
                              y="10"
                              width="14"
                              height="10"
                              rx="2">
                        </rect>

                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                    </svg>

                    Protected account access

                </div>


            </section>


        </main>



        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <footer class="footer">


            <span>
                © 2026 SuperEncryption
            </span>


            <div class="footer-links">

                <span>Privacy</span>

                <span>Security</span>

                <span>Help</span>

                <span>Terms</span>

            </div>


        </footer>


    </div>


</body>

</html>